# ============================================================
# Tutor Match — Flask + MySQL + Vanilla JS
# line endings: LF on all platforms
# ============================================================

# Default: normalize line endings automatically
*                 text=auto

# Python backend
*.py              text diff=python eol=lf

# Web frontend
*.html            text diff=html eol=lf
*.css             text diff=css  eol=lf
*.js              text           eol=lf
*.json            text           eol=lf

# Database
*.sql             text           eol=lf

# Config / Docs
*.md              text diff=markdown eol=lf
*.txt             text eol=lf
*.env             text eol=lf
*.cfg             text eol=lf
*.ini             text eol=lf
*.toml            text eol=lf
*.yaml            text eol=lf
*.yml             text eol=lf
.gitattributes    text eol=lf
.gitignore        text eol=lf

# Windows scripts (ต้องใช้ CRLF)
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

# Binary — ห้าม normalize
*.jpg             binary
*.jpeg            binary
*.png             binary
*.gif             binary
*.ico             binary
*.webp            binary
*.pdf             binary
*.zip             binary
*.gz              binary
*.tar             binary
*.pyc             binary
*.woff            binary
*.woff2           binary
*.ttf             binary
*.otf             binary
